{
    "remove_urls": true,
    "escape_ssml": true,
    "remove_emojis": true,
    "compress_spaces_and_newlines": true,
    "regex_delete": [
        "[\\*＊_＿\\^＾\\\\￥#＃]",
        "[~〜]",
        "(?s)[ \\t]*```mermaid.*?```",
        "aside|⚠|`|・",
        "[\\u200B-\\u200D\\uFEFF]",
        "\\(.*?\\)",
        "＼.*?／"
    ],
    "regex_replacements": [
        {
            "pattern": "[/／|｜]",
            "replacement": "、"
        },
        {
            "pattern": "※",
            "replacement": "注意、"
        },
        {
            "pattern": "【|】|〔|〕|［|］|（|）|『|』",
            "replacement": "、"
        }
    ],
    "string_delete": [
        "@",
        "＠"
    ],
    "string_replacements": []
}